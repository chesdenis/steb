@* View of STEB2.Controls.ProjectAquatory. *@
<div class="toolbar">
    <button @onclick="() => model.button_Add_Click(model.button_Add, EventArgs.Empty)">@L.T(model.button_Add.Text)</button>
    <button disabled="@(model.listView_Aquatories.SelectedItems.Count == 0)" @onclick="() => model.button_Delete_Click(model.button_Delete, EventArgs.Empty)">@L.T(model.button_Delete.Text)</button>
</div>
<div class="caption">@L.T(model.label1.Text)</div>
<ListViewTable List="model.listView_Aquatories" />
<p class="muted small">@L.T("Для расчета используется плотность первой акватории в списке.")</p>

@if (pending != null)
{
    <Modal Title="@L.T("Введите название и плотность акватории")" Class="small" CloseText="@L.T("Готово")" OnClose="CloseAdd">
        <div class="grid2 narrow">
            <label>@L.T(pending.Value.label.Text)</label><TextField Box="pending.Value.textBox" />
            <label>@L.T("Плотность акватории")</label><NumberField Field="pending.Value.number" />
        </div>
    </Modal>
}

@code {
    private STEB2.Controls.ProjectAquatory model;
    private (System.Windows.Forms.TextBox textBox, STEB2.usgNumberField number, System.Windows.Forms.Label label)? pending;

    protected override void OnInitialized()
    {
        model = new STEB2.Controls.ProjectAquatory();
        model.AddRequested += (t, n, l) => pending = (t, n, l);
    }

    private void CloseAdd()
    {
        var p = pending.Value;
        pending = null;
        model.button_Add_DialogClosed(p.textBox, p.number, p.label);
    }
}
