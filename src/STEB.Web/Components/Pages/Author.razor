@page "/author"
@* "Об авторе" — added in the 2026 port (not part of the 2010 program). *@

<PageTitle>@L.T("Об авторе — STEB")</PageTitle>

<div class="author-page">
    <div class="card author-card">
        <div class="about-logo">STEB</div>
        <div class="author-text">
            <div class="author-label">@L.T("Автор")</div>
            <div class="author-name">Denis Chesnokov, 2026</div>
            <p class="muted small">
                @L.T("Программа расчёта посадки судна при различной загрузке (STEB, 2010).")<br />
                @L.T("Исходный код восстановлен и перенесён на .NET / ASP.NET Core Blazor в 2026 году.")
            </p>
            <div class="author-links">
                <a href="https://github.com/chesdenis" target="_blank" rel="noopener">GitHub: github.com/chesdenis</a>
                <a href="https://www.linkedin.com/in/denis-chesnokov-aa3646183" target="_blank" rel="noopener">LinkedIn: linkedin.com/in/denis-chesnokov-aa3646183</a>
            </div>
            <p class="author-disclaimer">
                @L.T("Только для учебных целей. Программа предоставляется «как есть», без каких-либо гарантий; автор не несёт ответственности за её использование и результаты расчётов.")
                <br />MIT License · © 2010, 2026 Denis Chesnokov
            </p>
            <a class="author-back" href="">@L.T("← К списку проектов")</a>
        </div>
    </div>
</div>
